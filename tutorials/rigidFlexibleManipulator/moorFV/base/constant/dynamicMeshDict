FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh      dynamicMotionSolverFvMesh;
motionSolverLibs   ("libfiniteVolumeBeamMooring");
motionSolver       sixDoFRigidBodyMotionFvBeam;

sixDoFRigidBodyMotionFvBeamCoeffs
{
    patches          (floatingObject);
    // Every mesh point within innerDistance moves with the body: the whole
    // block turns rigidly with the crank
    innerDistance    100;
    outerDistance    101;

    // Fluid forces are ignored: the crank moves under the beam only
    test             true;

    // The rigid crank, as in the beamFoam-only case: centre of mass at the
    // hinge, held there, turning about z only. Jz = 8.1707 kg m^2 about the
    // hinge (same inertia as the flexible link)
    mass             0.8;
    centreOfMass     (-0.8 0 0);
    orientation      (1 0 0 0 1 0 0 0 1);
    momentOfInertia  (16 8.1707 8.1707);
    // Jz omega = 8.1707 x 10: the crank starts turning at 10 rad/s
    angularMomentum  (0 0 81.707);

    solver
    {
        type            SOLVER;
        jacobianCheck   2;
    }

    // Partitioned (FvBeamNewmark) only: under-relaxation of the body
    // acceleration between outer correctors
    accelerationRelaxation RELAX;

    constraints
    {
        hinge
        {
            sixDoFRigidBodyMotionFvBeamConstraint point;
            centreOfRotation (-0.8 0 0);
        }
        zAxis
        {
            sixDoFRigidBodyMotionFvBeamConstraint axis;
            axis (0 0 1);
        }
    }

    restraints
    {
        beam
        {
            sixDoFRigidBodyMotionFvBeamRestraint finiteVolumeBeam;
            // The link's left end is at the crank tip; its right end is free
            attachmentPatch  left;
            anchorPatch      right;
            beamRegion       "beam";
            refAttachmentPt  (0 0 0);
            // Revolute joint: force only
            joint            pin;
        }
    }
}


