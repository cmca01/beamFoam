FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/beam";
    object      Omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initial link spin Omega0 = -k/omega = -0.313316 rad/s about z
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform (0 0 -0.3133159269);

boundaryField
{
    left
    {
        type            calculated;
        value           uniform (0 0 -0.3133159269);
    }
    right
    {
        type            calculated;
        value           uniform (0 0 -0.3133159269);
    }
    beam
    {
        type            empty;
    }
}

