FoamFile
{
    version     2.0;
    format      ascii;
    class       surfaceTensorField;
    location    "0/beam";
    object      CQ;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// diag(EA, GA, GA) = 1e6 N (paper, Fig. 9)
dimensions      [1 1 -2 0 0 0 0];

internalField   uniform (1e6 0 0 0 1e6 0 0 0 1e6);

boundaryField
{
    left
    {
        type            calculated;
        value           uniform (1e6 0 0 0 1e6 0 0 0 1e6);
    }
    right
    {
        type            calculated;
        value           uniform (1e6 0 0 0 1e6 0 0 0 1e6);
    }
    beam
    {
        type            empty;
    }
}

