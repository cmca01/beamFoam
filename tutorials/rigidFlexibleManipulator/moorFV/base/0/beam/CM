FoamFile
{
    version     2.0;
    format      ascii;
    class       surfaceTensorField;
    location    "0/beam";
    object      CM;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// diag(GJ, EI, EI) = 1e5 N m^2 (paper, Fig. 9)
dimensions      [1 3 -2 0 0 0 0];

internalField   uniform (1e5 0 0 0 1e5 0 0 0 1e5);

boundaryField
{
    left
    {
        type            calculated;
        value           uniform (1e5 0 0 0 1e5 0 0 0 1e5);
    }
    right
    {
        type            calculated;
        value           uniform (1e5 0 0 0 1e5 0 0 0 1e5);
    }
    beam
    {
        type            empty;
    }
}

