FoamFile
{
    version     2.0;
    format      ascii;
    class       volTensorField;
    location    "0/beam";
    object      CIRho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Rotary inertia per unit length J_rho = diag(20, 10, 10) (paper, Fig. 9)
dimensions      [1 1 0 0 0 0 0];

internalField   uniform (20 0 0 0 10 0 0 0 10);

boundaryField
{
    left
    {
        type            calculated;
        value           uniform (20 0 0 0 10 0 0 0 10);
    }
    right
    {
        type            calculated;
        value           uniform (20 0 0 0 10 0 0 0 10);
    }
    beam
    {
        type            empty;
    }
}

