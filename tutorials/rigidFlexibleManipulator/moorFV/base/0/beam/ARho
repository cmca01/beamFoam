FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/beam";
    object      ARho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mass per unit length A_rho (paper, Fig. 9)
dimensions      [1 -1 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    left
    {
        type            calculated;
        value           uniform 1;
    }
    right
    {
        type            calculated;
        value           uniform 1;
    }
    beam
    {
        type            empty;
    }
}

