FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

// Rigid-flexible manipulator: Ibrahimbegovic & Mamouri (2000), CMAME 188,
// 805-831, section 6.2, Fig. 9. A rigid crank of length 0.8 m turns about a
// fixed hinge at (-0.8 0 0) at 10 rad/s; a flexible link of length 0.8 m is
// joined to the crank tip (0 0 0) by a revolute joint and is otherwise free.
//
// The section and E, G, rho below give roughly the paper's properties; the
// exact values (EA = GA = 1e6, EI = GJ = 1e5, A_rho = 1,
// J_rho = diag(20, 10, 10)) are set by 0/CQ, 0/CM, 0/ARho and 0/CIRho,
// which override them
beams
(
    beam_0
    {
        crossSectionModel    circle;
        circleCrossSectionModelDict
        {
            radius    0.632456;
        }
        length       0.8;
        nSegments    8;
        E            7.95775e5;
        G            7.95775e5;
        rho          0.795775;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    // No buoyancy
    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 0;

    startPatchName    left;
    endPatchName      right;

    nCorrectors       200;
    solutionTol       1e-10;
    // Round-off floor of the force residual
    absoluteTol       1e-8;
    debug no;

    rigidBodyCoupling partitioned;

    // The rigid crank. Its centre of mass is put at the hinge and held there
    // (fixedTranslation), and it turns only about z (rotationAxis), so it
    // rotates about the hinge. Mass and inertia as the flexible link (the
    // paper: "the length and inertia of each component are the same"):
    // about the hinge, Jz = A_rho L^3/3 + J_rho,z L = 0.171 + 8 = 8.171 kg m^2
    rigidBodyEnd
    {
        patch               left;
        // Revolute joint: force only (the motion is planar)
        joint               pin;
        mass                0.8;
        momentOfInertia     (16 8.1707 8.1707);
        centreOfMass        (-0.8 0 0);
        fixedTranslation    yes;
        rotationAxis        (0 0 1);
        angularVelocity     (0 0 10);
        // Trapezoidal rule: no numerical damping
        newmarkBeta         0.25;
        newmarkGamma        0.5;
        // Partitioned: iterate to convergence
        nCouplingIterations 50;
        couplingTolerance   1e-10;
        // Monolithic only: finite-difference check of the body columns in
        // the first 2 time steps
        jacobianCheck       2;
    }
}


